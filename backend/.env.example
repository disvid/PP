# Environment variables read by the backend. Set them on your host or in the container; nothing loads this file.

# Port to listen on (default 3000)
PORT=3000

# Origin(s) of the deployed frontend, allowed by CORS for the REST API and Socket.IO. Several: comma separated.
# Leave unset in local development (every origin is accepted and Vite proxies the API).
FRONTEND_URL=https://your-app.vercel.app

# Where shareable level links point (defaults to the first FRONTEND_URL)
# PUBLIC_URL=https://your-app.vercel.app

# SQLite file (default: backend/data/proof-puzzle.db). In Docker, put it on a mounted volume.
DB_PATH=/data/proof-puzzle.db

# Secret that signs session tokens (JWTs). Set a long random value in production, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Without it, production uses a random key per process, so every restart signs everybody out.
JWT_SECRET=change-me

# Set to 0 to force the built-in mock engine even if Lean 4 is installed
# USE_LEAN=0
